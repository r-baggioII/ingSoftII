# .env - variables para Docker (no comitear; añadir a .gitignore)

# Application
SPRING_APPLICATION_NAME=greedy_gym

# DataSource (apunta al servicio de la DB en docker-compose)
SPRING_DATASOURCE_URL=jdbc:mariadb://greedy_gym_db:3306/greedy_gym?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=adminAdmin

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_NAMING_STRATEGY=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# Mail
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=greedyteam0@gmail.com
SPRING_MAIL_PASSWORD=upiz bhvd orss pqls
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
SPRING_MAIL_DEFAULT_ENCODING=UTF-8

# Cron expressions
GREEDY_MAIL_CUMPLEANIOS_CRON=0/30 * * * * ?
GREEDY_MAIL_PROMOCIONES_CRON=0/30 * * * * ?

# Logging
LOG_LEVEL_NOTIFICADOR=INFO
LOG_LEVEL_SPRING_MAIL=DEBUG

# MercadoPago (poner el token real en producción)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-1161916719081917-092219-7d27c8faacdc9c984b9bd4539830b21b-2708507674
MERCADOPAGO_BACK_URL_SUCCESS=https://roily-hydraulic-renna.ngrok-free.dev/greedy_gym/api/socio/pagos/success
MERCADOPAGO_BACK_URL_PENDING=https://roily-hydraulic-renna.ngrok-free.dev/greedy_gym/api/socio/pagos/pending
MERCADOPAGO_BACK_URL_FAILURE=https://roily-hydraulic-renna.ngrok-free.dev/greedy_gym/api/socio/pagos/failure

# MariaDB (usado por el servicio DB en docker-compose)
MARIADB_ROOT_PASSWORD=adminAdmin
MARIADB_DATABASE=greedy_gym

# Opcional: parámetros JVM & otros
#JAVA_OPTS=-Xms512m -Xmx1024m

